{
  "name": "nexgen-build-broker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACT_UPLOADS",
      "bucket_name": "nexgen-build-uploads"
    }
  ]
}
